---
import Blog from "@components/Blog.astro";
import { blogMeta } from "@data/constants";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const feedPath = "/rss.xml";
const feedUrl = new URL(feedPath, Astro.site).href;
---

<Layout
  title={blogMeta.title}
  description={blogMeta.description}
  ogImage={blogMeta.ogImage}
>
  <section aria-label="Articles">
    <ul class="post-list post-list--home">
      {posts.map((post) => <Blog {...post} />)}
    </ul>
    <p class="blog-feed">
      Follow new posts via RSS. <a
        class="blog-feed-link"
        id="copy-feed"
        href={feedPath}
        data-feed-url={feedUrl}>Copy the feed address.</a
      >
    </p>
    <p class="sr-only" id="feed-status" role="status" aria-live="polite"></p>
  </section>
</Layout>

<script>
  const copyLink = document.getElementById("copy-feed");
  const copyStatus = document.getElementById("feed-status");

  if (
    copyLink instanceof HTMLAnchorElement &&
    copyStatus instanceof HTMLElement &&
    navigator.clipboard
  ) {
    const feedUrl = copyLink.dataset.feedUrl;
    const idleLabel = copyLink.textContent?.trim() ?? "Copy the feed address.";
    let resetLabelTimer: number | undefined;

    copyLink.addEventListener("click", async (event) => {
      if (!feedUrl) return;

      event.preventDefault();

      try {
        await navigator.clipboard.writeText(feedUrl);
        copyLink.textContent = "Copied.";
        copyStatus.textContent = "Feed address copied.";
      } catch {
        window.location.assign(copyLink.href);
        return;
      }

      window.clearTimeout(resetLabelTimer);
      resetLabelTimer = window.setTimeout(() => {
        copyLink.textContent = idleLabel;
        copyStatus.textContent = "";
      }, 2600);
    });
  }
</script>
