---
import Blog from "@components/Blog.astro";
import { blogMeta } from "@data/constants";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const feedPath = "/rss.xml";
const feedUrl = new URL(feedPath, Astro.site).href;
---

<Layout
  title={blogMeta.title}
  description={blogMeta.description}
  ogImage={blogMeta.ogImage}
>
  <section aria-label="Articles">
    <ul class="post-list post-list--home">
      {posts.map((post) => <Blog {...post} />)}
    </ul>
    <p class="blog-feed">
      Follow new posts via RSS. <a
        class="blog-feed-link"
        id="copy-feed"
        href={feedPath}
        data-feed-url={feedUrl}>Copy the feed address.</a
      >
    </p>
    <p class="sr-only" id="feed-status" role="status" aria-live="polite"></p>
  </section>
</Layout>

<script>
  let cleanupFeedLink: (() => void) | undefined;

  function setupFeedLink() {
    cleanupFeedLink?.();
    cleanupFeedLink = undefined;

    const copyLink = document.getElementById("copy-feed");
    const copyStatus = document.getElementById("feed-status");
    if (
      !(copyLink instanceof HTMLAnchorElement) ||
      !(copyStatus instanceof HTMLElement) ||
      !navigator.clipboard
    ) {
      return;
    }

    const activeLink = copyLink;
    const activeStatus = copyStatus;
    const feedUrl = activeLink.dataset.feedUrl;
    const idleLabel =
      activeLink.textContent?.trim() ?? "Copy the feed address.";
    let disposed = false;
    let resetLabelTimer: number | undefined;

    async function handleCopy(event: MouseEvent) {
      if (!feedUrl) return;

      event.preventDefault();

      try {
        await navigator.clipboard.writeText(feedUrl);
        if (disposed) return;
        activeLink.textContent = "Copied.";
        activeStatus.textContent = "Feed address copied.";
      } catch {
        if (disposed) return;
        window.location.assign(activeLink.href);
        return;
      }

      window.clearTimeout(resetLabelTimer);
      resetLabelTimer = window.setTimeout(() => {
        activeLink.textContent = idleLabel;
        activeStatus.textContent = "";
      }, 2600);
    }

    activeLink.addEventListener("click", handleCopy);
    cleanupFeedLink = () => {
      disposed = true;
      activeLink.removeEventListener("click", handleCopy);
      window.clearTimeout(resetLabelTimer);
      activeLink.textContent = idleLabel;
      activeStatus.textContent = "";
    };
  }

  function teardownFeedLink() {
    cleanupFeedLink?.();
    cleanupFeedLink = undefined;
  }

  document.addEventListener("astro:page-load", setupFeedLink);
  document.addEventListener("astro:before-swap", teardownFeedLink);
</script>
