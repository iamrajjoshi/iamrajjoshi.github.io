---
import atlas from "~/assets/ollie/spritesheet.webp";
import still from "~/assets/ollie/still.webp";
import OllieLamp from "./OllieLamp.astro";
import OllieSunglasses from "./OllieSunglasses.astro";
---

<button
  class="ollie-avatar"
  type="button"
  data-ollie-avatar
  data-atlas={atlas.src}
  data-lamp-phase="off"
  data-sunglasses-phase="off"
  aria-label="Ollie"
  title="Ollie"
  disabled
>
  <OllieLamp />
  <img
    class="ollie-still"
    src={still.src}
    width="96"
    height="104"
    alt=""
    aria-hidden="true"
    decoding="async"
    fetchpriority="high"
  />
  <span class="ollie-sprite" aria-hidden="true"></span>
  <OllieSunglasses />
</button>

<script>
  import { createOllieBehavior } from "../lib/ollie-animation";

  // Ollie's mood and time without attention survive navigation between pages.
  const behavior = createOllieBehavior();
  let cleanup: (() => void) | undefined;

  function setupOllie() {
    cleanup?.();
    const button = document.querySelector<HTMLButtonElement>(
      "[data-ollie-avatar]",
    );
    const sprite = button?.querySelector<HTMLElement>(".ollie-sprite");
    const source = button?.dataset.atlas;
    if (!button || !sprite || !source) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const image = new Image();
    let timer: number | undefined;
    let inViewport = false;
    let loaded = false;
    let loading = false;
    let disposed = false;
    let darkMode = document.documentElement.dataset.theme === "dark";

    function paint() {
      const { frame, mood, delay } = behavior.sample(Date.now());
      sprite!.style.backgroundPosition = `${(frame.column * 100) / 7}% ${frame.row * 10}%`;
      button!.dataset.animation = frame.animation;
      button!.dataset.frame = `${frame.row}:${frame.column}`;
      button!.dataset.mood = mood;
      button!.dataset.lampPhase =
        darkMode && !reducedMotion.matches ? (frame.lampPhase ?? "off") : "off";
      button!.dataset.sunglassesPhase =
        !darkMode && !reducedMotion.matches
          ? (frame.sunglassesPhase ?? "off")
          : "off";
      return delay;
    }

    function canPlay() {
      return (
        !disposed &&
        loaded &&
        inViewport &&
        !document.hidden &&
        !reducedMotion.matches
      );
    }

    function schedule() {
      if (!canPlay() || timer !== undefined) return;
      const delay = paint();
      button!.dataset.playing = "true";
      timer = window.setTimeout(() => {
        timer = undefined;
        if (!canPlay()) return;
        schedule();
      }, delay);
    }

    function syncPlayback() {
      window.clearTimeout(timer);
      timer = undefined;
      button!.dataset.playing = "false";
      button!.disabled = reducedMotion.matches || !loaded;
      const label = button!.disabled ? "Ollie" : "Say hi to Ollie";
      button!.setAttribute("aria-label", label);
      button!.title = label;
      paint();

      // Reduced motion and no-JS visitors only need the small still image.
      if (!reducedMotion.matches && !loaded && !loading) {
        loading = true;
        image.src = source!;
      }
      schedule();
    }

    image.onload = () => {
      if (disposed) return;
      loaded = true;
      sprite.style.backgroundImage = `url("${source}")`;
      button.dataset.ready = "true";
      paint();
      syncPlayback();
    };
    image.onerror = () => {
      if (disposed) return;
      button.disabled = true;
      button.title = "Ollie";
      button.setAttribute("aria-label", "Ollie");
    };

    const observer = new IntersectionObserver(([entry]) => {
      inViewport = entry?.isIntersecting ?? false;
      syncPlayback();
    });
    const greetOllie = () => {
      if (!behavior.react(Date.now())) return;
      syncPlayback();
    };
    const themeChanged = (event: Event) => {
      const { theme } = (event as CustomEvent<{ theme: "light" | "dark" }>)
        .detail;
      darkMode = theme === "dark";
      if (loaded && inViewport && !document.hidden && !reducedMotion.matches) {
        behavior.changeTheme(theme, Date.now());
      } else {
        behavior.cancelThemeTransition(Date.now());
      }
      syncPlayback();
    };
    const motionChanged = () => {
      if (reducedMotion.matches) behavior.cancelThemeTransition(Date.now());
      syncPlayback();
    };
    button.addEventListener("click", greetOllie);
    document.addEventListener("visibilitychange", syncPlayback);
    document.addEventListener("theme:change", themeChanged);
    reducedMotion.addEventListener("change", motionChanged);
    observer.observe(button);
    paint();
    syncPlayback();

    cleanup = () => {
      disposed = true;
      window.clearTimeout(timer);
      observer.disconnect();
      image.onload = null;
      image.onerror = null;
      button.removeEventListener("click", greetOllie);
      document.removeEventListener("visibilitychange", syncPlayback);
      document.removeEventListener("theme:change", themeChanged);
      reducedMotion.removeEventListener("change", motionChanged);
    };
  }

  document.addEventListener("astro:page-load", setupOllie);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

<style>
  .ollie-avatar {
    position: relative;
    display: block;
    width: 4rem;
    aspect-ratio: 12 / 13;
    flex: 0 0 4rem;
    padding: 0;
    border: 0;
    border-radius: 0.35rem;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .ollie-avatar:disabled {
    cursor: default;
  }

  .ollie-still,
  .ollie-sprite {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  .ollie-sprite {
    position: absolute;
    inset: 0;
    visibility: hidden;
    background-repeat: no-repeat;
    background-size: 800% 1100%;
  }

  .ollie-avatar[data-ready="true"] .ollie-still {
    visibility: hidden;
  }

  .ollie-avatar[data-ready="true"] .ollie-sprite {
    visibility: visible;
  }

  @media (max-width: 30em) {
    .ollie-avatar {
      width: 3.25rem;
      flex-basis: 3.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ollie-avatar[data-ready="true"] .ollie-still {
      visibility: visible;
    }

    .ollie-avatar[data-ready="true"] .ollie-sprite {
      visibility: hidden;
    }
  }
</style>
