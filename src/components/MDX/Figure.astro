---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  caption?: string;
}

const { light, dark, alt, caption } = Astro.props;

// PNG figures are drawn at 2x, so half the file's width is their true size on the page.
// SVGs carry their page size and are served as they are, so they stay sharp when zoomed.
const size = (image: ImageMetadata) => ({
  width: Math.round(image.width / 2),
  height: Math.round(image.height / 2),
});
---

<figure class="figure">
  {
    [light, dark].map(
      (image, i) =>
        image &&
        (image.format === "svg" ? (
          <img
            class={dark && (i ? "fig-dark" : "fig-light")}
            src={image.src}
            alt={alt}
            width={image.width}
            height={image.height}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <Image
            class={dark && (i ? "fig-dark" : "fig-light")}
            src={image}
            alt={alt}
            {...size(image)}
            densities={[1, 2]}
            quality="high"
          />
        )),
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
